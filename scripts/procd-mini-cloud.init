#!/bin/sh /etc/rc.common
# mini-cloud procd 守护脚本（RV-2026-11-18-01 F：崩溃自动拉起）
#
# 背景：低内存路由器上 Go 程序的 fatal error（如内存耗尽）不可 recover，
# 进程直接消失且无守护时长期宕机（本次事故空窗约 14 分钟）。
# procd 的 respawn 是比「避免崩溃」更可靠的兜底（PM 原则①：mini-cloud 可以崩，
# 但必须能自愈，且不能拖垮路由器）。
#
# 安装（路由器上，root）：
#   cp /data/mini-cloud/scripts/procd-mini-cloud.init /etc/init.d/mini-cloud
#   chmod +x /etc/init.d/mini-cloud
#   /etc/init.d/mini-cloud enable        # 开机自启
#   /etc/init.d/mini-cloud start         # 立即启动（首次安装时先停掉旧进程）
#
# 说明：
# - 经 sh -c 包装把日志追加到 /data/mini-cloud/mini-cloud.log
#   （procd 的 stdout 参数只支持 /dev/null 或 syslog，无法追加文件；
#   部署脚本健康检查依赖该日志文件，故用重定向保持兼容）。
# - 不设 file 参数与 reload 触发器：配置变更后由部署脚本或手工
#   /etc/init.d/mini-cloud restart，避免 /admin 每次写回配置都打断播放。
# - 部署脚本 scripts/deploy-router.sh 已适配：检测到本脚本时改用
#   /etc/init.d/mini-cloud stop/start 停启（否则 procd 会立即拉起旧进程）。

START=95
STOP=10

USE_PROCD=1
PROG=/data/mini-cloud/mini-cloud-arm64-upx
CONFIG=/data/mini-cloud/config/config.json
LOG=/data/mini-cloud/mini-cloud.log

start_service() {
    procd_open_instance
    # exec 保持同一 PID，procd 的 respawn 监控不受 sh 包装影响
    procd_set_param command /bin/sh -c "exec $PROG -config $CONFIG >> $LOG 2>&1"
    # respawn <threshold> <timeout> <retry>：
    # 启动后 threshold(3600s) 内崩溃 → 立即拉起，连续 retry(5) 次仍崩则放弃（防崩溃循环）；
    # 运行超过 threshold 后崩溃 → 等 timeout(5s) 拉起。
    procd_set_param respawn 3600 5 5
    procd_set_param limits core="0"
    procd_close_instance
}

reload_service() {
    stop
    start
}
